<?xml version="1.0" encoding="utf-8"?>
<!-- v17 孩子端图标：深蓝底 + 青绿渐变齿轮（8 个清晰齿）+ 中部横槽 + 中心圆点 + 圆角方框描边 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 圆角方框描边：外层渐变实心 + 内层底色叠加 = 渐变描边（上绿下青） -->
    <path android:pathData="M35,20 h38 a15,15 0 0 1 15,15 v38 a15,15 0 0 1 -15,15 h-38 a15,15 0 0 1 -15,-15 v-38 a15,15 0 0 1 15,-15 z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="20" android:startY="20"
                android:endX="20" android:endY="88"
                android:type="linear">
                <item android:offset="0.0" android:color="#FF34D399" />
                <item android:offset="1.0" android:color="#FF22D3EE" />
            </gradient>
        </aapt:attr>
    </path>
    <path
        android:fillColor="#0A1A2F"
        android:pathData="M35,24 h38 a11,11 0 0 1 11,11 v38 a11,11 0 0 1 -11,11 h-38 a11,11 0 0 1 -11,-11 v-38 a11,11 0 0 1 11,-11 z" />

    <!-- 齿轮渐变：左下青 → 右上绿 -->
    <!-- 8 个齿轮齿：宽 9.6，径向 16→26，旋转复制 -->
    <path android:pathData="M49.2,28 h9.6 v10 h-9.6 z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="35" android:startY="76"
                android:endX="73" android:endY="30"
                android:type="linear">
                <item android:offset="0.0" android:color="#FF2DD4BF" />
                <item android:offset="1.0" android:color="#FF4ADE80" />
            </gradient>
        </aapt:attr>
    </path>
    <group android:pivotX="54" android:pivotY="54" android:rotation="45">
        <path android:pathData="M49.2,28 h9.6 v10 h-9.6 z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:startX="35" android:startY="76"
                    android:endX="73" android:endY="30"
                    android:type="linear">
                    <item android:offset="0.0" android:color="#FF2DD4BF" />
                    <item android:offset="1.0" android:color="#FF4ADE80" />
                </gradient>
            </aapt:attr>
        </path>
    </group>
    <group android:pivotX="54" android:pivotY="54" android:rotation="90">
        <path android:pathData="M49.2,28 h9.6 v10 h-9.6 z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:startX="35" android:startY="76"
                    android:endX="73" android:endY="30"
                    android:type="linear">
                    <item android:offset="0.0" android:color="#FF2DD4BF" />
                    <item android:offset="1.0" android:color="#FF4ADE80" />
                </gradient>
            </aapt:attr>
        </path>
    </group>
    <group android:pivotX="54" android:pivotY="54" android:rotation="135">
        <path android:pathData="M49.2,28 h9.6 v10 h-9.6 z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:startX="35" android:startY="76"
                    android:endX="73" android:endY="30"
                    android:type="linear">
                    <item android:offset="0.0" android:color="#FF2DD4BF" />
                    <item android:offset="1.0" android:color="#FF4ADE80" />
                </gradient>
            </aapt:attr>
        </path>
    </group>
    <group android:pivotX="54" android:pivotY="54" android:rotation="180">
        <path android:pathData="M49.2,28 h9.6 v10 h-9.6 z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:startX="35" android:startY="76"
                    android:endX="73" android:endY="30"
                    android:type="linear">
                    <item android:offset="0.0" android:color="#FF2DD4BF" />
                    <item android:offset="1.0" android:color="#FF4ADE80" />
                </gradient>
            </aapt:attr>
        </path>
    </group>
    <group android:pivotX="54" android:pivotY="54" android:rotation="225">
        <path android:pathData="M49.2,28 h9.6 v10 h-9.6 z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:startX="35" android:startY="76"
                    android:endX="73" android:endY="30"
                    android:type="linear">
                    <item android:offset="0.0" android:color="#FF2DD4BF" />
                    <item android:offset="1.0" android:color="#FF4ADE80" />
                </gradient>
            </aapt:attr>
        </path>
    </group>
    <group android:pivotX="54" android:pivotY="54" android:rotation="270">
        <path android:pathData="M49.2,28 h9.6 v10 h-9.6 z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:startX="35" android:startY="76"
                    android:endX="73" android:endY="30"
                    android:type="linear">
                    <item android:offset="0.0" android:color="#FF2DD4BF" />
                    <item android:offset="1.0" android:color="#FF4ADE80" />
                </gradient>
            </aapt:attr>
        </path>
    </group>
    <group android:pivotX="54" android:pivotY="54" android:rotation="315">
        <path android:pathData="M49.2,28 h9.6 v10 h-9.6 z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:startX="35" android:startY="76"
                    android:endX="73" android:endY="30"
                    android:type="linear">
                    <item android:offset="0.0" android:color="#FF2DD4BF" />
                    <item android:offset="1.0" android:color="#FF4ADE80" />
                </gradient>
            </aapt:attr>
        </path>
    </group>

    <!-- 齿轮圆环：外圈 r=19.5 内圈 r=9.5（evenOdd 挖洞），渐变填充 -->
    <path
        android:fillType="evenOdd"
        android:pathData="M54,34.5 a19.5,19.5 0 1,0 0.02,0 z M54,44.5 a9.5,9.5 0 1,1 -0.02,0 z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="35" android:startY="76"
                android:endX="73" android:endY="30"
                android:type="linear">
                <item android:offset="0.0" android:color="#FF2DD4BF" />
                <item android:offset="1.0" android:color="#FF4ADE80" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 中部横向槽：底色切开齿轮（贯穿两侧齿，形成参考图的横杠效果） -->
    <path
        android:fillColor="#0A1A2F"
        android:pathData="M25,51.5 h58 v5 h-58 z" />

    <!-- 中心圆点 -->
    <path android:pathData="M54,50.6 a3.4,3.4 0 1,0 0.02,0 z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="35" android:startY="76"
                android:endX="73" android:endY="30"
                android:type="linear">
                <item android:offset="0.0" android:color="#FF2DD4BF" />
                <item android:offset="1.0" android:color="#FF4ADE80" />
            </gradient>
