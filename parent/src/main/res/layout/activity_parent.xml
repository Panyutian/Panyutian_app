<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvAppTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginBottom="16dp"
            android:text="🛡️ 家长控制端 v3.0"
            android:textSize="24sp"
            android:textStyle="bold" />

        <!-- ============ v3.0 新增：控制模式 ============ -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📡 控制模式"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:layout_marginBottom="8dp" />

                <RadioGroup
                    android:id="@+id/rgMode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">

                    <RadioButton
                        android:id="@+id/rbMqtt"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="🌐 跨网络 (MQTT)"
                        android:textSize="14sp"
                        android:checked="true" />

                    <RadioButton
                        android:id="@+id/rbHttp"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="🏠 同 WiFi (HTTP)"
                        android:textSize="14sp" />
                </RadioGroup>

                <!-- MQTT 模式：DeviceId 输入（锁定 + 解锁） -->
                <LinearLayout
                    android:id="@+id/llMqttInputs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="孩子手机 DeviceId（如 honor_ARMR023407000870）">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etDeviceId"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="text" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnUnlockDeviceId"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="🔓 解锁"
                            android:textSize="13sp"
                            app:backgroundTint="#FF9800" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvOnlineStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="🔄 MQTT 连接中..."
                        android:textSize="13sp"
                        android:textColor="#666666"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="4dp" />
                </LinearLayout>

                <!-- HTTP 模式：IP 输入（原有，放到模式卡内） -->
                <LinearLayout
                    android:id="@+id/llHttpInputs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="孩子手机 IP（如 192.168.0.32）">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etIp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text"
                            android:text="192.168.0.32" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="家长锁密码"
                        app:passwordToggleEnabled="true">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etPwd"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textPassword" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnUnlockPwd"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="🔓 解锁"
                        android:textSize="13sp"
                        app:backgroundTint="#FF9800" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvMqttDebug"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="⏳ 等待 MQTT 连接..."
                    android:textSize="12sp"
                    android:textColor="#888888"
                    android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="🔄 刷新状态"
            android:textSize="16sp"
            app:backgroundTint="#1976D2" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📋 当前状态"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/tvStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="点「刷新状态」查询"
                    android:textSize="15sp"
                    android:lineSpacingExtra="4dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="暂停时长："
                android:textSize="16sp"
                android:layout_gravity="center_vertical" />

            <EditText
                android:id="@+id/etMinutes"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:inputType="number"
                android:text="10"
                android:hint="分钟" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" 分钟"
                android:textSize="16sp"
                android:layout_gravity="center_vertical" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPause"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="⏸️ 暂停游戏拦截"
            android:textSize="16sp"
            app:backgroundTint="#FF6F00" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnResume"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="▶️ 启动游戏拦截"
            android:textSize="16sp"
            app:backgroundTint="#43A047" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="12dp"
            android:background="#E0E0E0" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📦 安装管控"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBlockInstall"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="🚫 禁止安装 APP/游戏"
            android:textSize="16sp"
            app:backgroundTint="#D32F2F" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAllowInstall"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="✅ 允许安装 APP/游戏"
            android:textSize="16sp"
            app:backgroundTint="#43A047" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="12dp"
            android:background="#E0E0E0" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔒 远程锁屏"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="锁定时长："
                android:textSize="16sp"
                android:layout_gravity="center_vertical" />

            <EditText
                android:id="@+id/etLockMinutes"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:inputType="number"
                android:text="30"
                android:hint="分钟" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" 分钟（到时自动解）"
                android:textSize="15sp"
                android:layout_gravity="center_vertical" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="4dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLockFor"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="⏱ 定时锁定 N 分钟"
                android:textSize="14sp"
                app:backgroundTint="#E65100" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLockNow"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="🔒 永久锁屏"
                android:textSize="14sp"
                app:backgroundTint="#6A1B9A" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnUnlock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="🔓 解除强制锁屏"
            android:textSize="15sp"
            app:backgroundTint="#1976D2" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="12dp"
            android:background="#E0E0E0" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📱 APP 管理（远程隐藏/显示）"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAppHistory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="� 查看孩子APP使用动态"
            android:textSize="15sp"
            app:backgroundTint="#EF6C00" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnListApps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="🔍 扫描孩子手机 APP 列表"
            android:textSize="15sp"
            app:backgroundTint="#43A047" />

        <!-- APP 清单紧跟扫描按钮下方 -->
        <LinearLayout
            android:id="@+id/llAppList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvAppListHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textColor="#888888"
            android:visibility="gone" />

        <!-- ============ v3.0.1: 家长远程推送孩子端更新 ============ -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="12dp"
            android:background="#E0E0E0" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔧 系统更新"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPushChildUpdate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="📡 推送孩子端更新"
            android:textSize="15sp"
            app:backgroundTint="#1976D2" />

        <TextView
            android:id="@+id/tvChildVersion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="孩子端版本：未知（未连接）"
            android:textSize="12sp"
            android:textColor="#666666"
            android:gravity="center"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="#888888"
            android:visibility="gone" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="💡 v3.0 使用说明：\n【跨网络 MQTT】两端只需有任何网络（WiFi/4G/5G），输入孩子手机 DeviceId 即可\n【同 WiFi HTTP】两端在同一局域网，输入孩子手机 IP（孩子端 App 标题栏可查看）\n孩子端 DeviceId 格式：honor_{手机序列号}，在孩子端 App 标题栏可查看"
            android:textSize="13sp"
            android:lineSpacingExtra="3dp"
            android:textColor="#666666" />

    </LinearLayout>
    </ScrollView>

    <!-- v26: 家长端启动认证锁覆盖层 -->
    <LinearLayout
        android:id="@+id/lockOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp"
        android:background="#FFFFFFFF"
        android:visibility="visible">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🛡️"
            android:textSize="64sp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="家长控制端"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#1976D2"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="请验证身份以继续"
            android:textSize="14sp"
            android:textColor="#666666"
            android:layout_marginBottom="32dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBiometricAuth"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔑 使用指纹/人脸验证"
            android:textSize="15sp"
            app:backgroundTint="#1976D2"
            android:layout_marginBottom="16dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPasswordAuth"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📝 使用密码验证"
            android:textSize="14sp"
            style="?attr/materialButtonOutlinedStyle"
            app:backgroundTint="#666666" />

    </LinearLayout>

</FrameLayout>
